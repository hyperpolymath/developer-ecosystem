#
# Contractile trust specification for the v-rtsp protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "stream-hijacking-injection-ssrf"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "cseq-matching", "session-id-validation", "sdp-parsing-safety", "transport-header-check"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-and-setup"
rollback = "reset-and-reconnect"
