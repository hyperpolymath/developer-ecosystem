#
# Contractile trust specification for the v-telnet protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "credential-cleartext-injection-mitm"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "iac-command-validation", "option-negotiation-tracking", "subnegotiation-length-limit", "nul-byte-handling"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-and-reauthenticate"
rollback = "reset-and-reconnect"
