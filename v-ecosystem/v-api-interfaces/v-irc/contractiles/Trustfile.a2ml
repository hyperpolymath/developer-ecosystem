#
# Contractile trust specification for the v-irc protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "flooding-nick-spoofing-channel-takeover"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "nick-collision-detection", "message-length-limit", "channel-mode-validation", "ctcp-sanitisation"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-with-exponential-backoff"
rollback = "reset-and-reconnect"
