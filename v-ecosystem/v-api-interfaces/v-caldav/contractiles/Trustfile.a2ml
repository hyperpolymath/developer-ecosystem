#
# Contractile trust specification for the v-caldav protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "calendar-injection-ics-parsing-xxe"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "etag-concurrency", "icalendar-validation", "propfind-depth-limit", "uid-uniqueness"]
build-contract = "v build src/"

[dust]
recovery = "refetch-and-merge"
rollback = "reset-and-reconnect"
