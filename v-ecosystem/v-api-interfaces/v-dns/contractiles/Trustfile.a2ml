#
# Contractile trust specification for the v-dns protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "dns-spoofing-amplification-cache-poisoning"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "query-id-randomisation", "response-matching", "ttl-enforcement", "label-length-check"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-alternate-server"
rollback = "reset-and-reconnect"
