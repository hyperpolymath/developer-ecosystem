#
# Contractile trust specification for the v-ca protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "private-key-exposure-certificate-misissuance"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "private-key-protection", "csr-field-validation", "acme-nonce-replay-prevention", "certificate-chain-verification"]
build-contract = "v build src/"

[dust]
recovery = "revoke-and-reissue"
rollback = "restore-previous-certificate"
