#
# Contractile trust specification for the v-syslog protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "log-injection-forging-flooding"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "facility-severity-range", "message-id-format", "structured-data-encoding", "timestamp-rfc3339"]
build-contract = "v build src/"

[dust]
recovery = "buffer-and-retry"
rollback = "reset-and-reconnect"
