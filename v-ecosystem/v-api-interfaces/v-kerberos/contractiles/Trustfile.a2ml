#
# Contractile trust specification for the v-kerberos protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "kdc-authentication-credential-cache"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "principal-name-parsing", "credential-lifetime-bounds", "keytab-path-validation", "enc-type-negotiation"]
build-contract = "v build src/"

[dust]
recovery = "re-kinit-and-retry"
rollback = "kdestroy-and-reinit"
