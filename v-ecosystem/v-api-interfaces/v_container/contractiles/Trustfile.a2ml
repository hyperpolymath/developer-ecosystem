#
# Contractile trust specification for the v-container protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "container-escape-image-tampering-privilege-escalation-resource-abuse"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "image-digest-verification", "resource-limit-enforcement", "namespace-isolation", "rootless-check"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
