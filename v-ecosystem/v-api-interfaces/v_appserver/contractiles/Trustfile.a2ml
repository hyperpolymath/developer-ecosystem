#
# Contractile trust specification for the v-appserver protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "code-injection-resource-exhaustion-privilege-escalation"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "process-isolation", "resource-quota-enforcement", "deployment-rollback", "log-integrity"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
