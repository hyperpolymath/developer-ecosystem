#
# Contractile trust specification for the v-deception protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "deception-bypass-honeytoken-fingerprinting-alert-suppression"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "alert-on-interaction", "decoy-isolation", "token-uniqueness", "stealth-verification"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
