#
# Contractile trust specification for the v-tftp protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "path-traversal-amplification"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "block-number-wrapping", "timeout-retransmit", "mode-validation", "filename-sanitisation"]
build-contract = "v build src/"

[dust]
recovery = "retransmit-last-block"
rollback = "reset-and-reconnect"
