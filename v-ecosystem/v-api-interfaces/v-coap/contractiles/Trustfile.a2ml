#
# Contractile trust specification for the v-coap protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "iot-amplification-resource-exhaustion"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "option-delta-encoding", "token-matching", "message-id-deduplication", "payload-marker-presence"]
build-contract = "v build src/"

[dust]
recovery = "retransmit-with-backoff"
rollback = "reset-and-reconnect"
