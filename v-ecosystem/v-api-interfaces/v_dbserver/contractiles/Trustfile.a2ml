#
# Contractile trust specification for the v-dbserver protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "sql-injection-data-exfiltration-replication-poisoning-backup-tampering"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "query-parameterisation", "connection-pool-bounds", "replication-integrity", "backup-verification"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
