#
# Contractile trust specification for the v-chat protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "message-injection-impersonation-metadata-leakage-e2ee-bypass"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "message-sanitisation", "auth-token-check", "rate-limiting", "e2ee-key-verification"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
