#
# Contractile trust specification for the v-doh protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "dns-spoofing-privacy-leak-downgrade"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "content-type-validation", "response-id-matching", "wire-format-check", "cache-control-enforcement"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-alternate-resolver"
rollback = "reset-and-reconnect"
