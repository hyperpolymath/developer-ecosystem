#
# Contractile trust specification for the v-webdav protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "network-facing-file-management"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "path-traversal-prevention", "xml-injection-prevention", "lock-token-validation", "http-status-validation"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "unlock-and-delete"
