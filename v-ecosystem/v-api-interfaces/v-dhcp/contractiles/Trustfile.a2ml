#
# Contractile trust specification for the v-dhcp protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "dhcp-starvation-rogue-server"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "option-length-bounds", "xid-uniqueness", "ip-address-validation", "lease-state-machine"]
build-contract = "v build src/"

[dust]
recovery = "rediscover-and-rebind"
rollback = "release-and-reinit"
