#
# Contractile trust specification for the v-authserver protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "credential-theft-token-forgery-session-hijacking-privilege-escalation"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "token-expiry-enforcement", "mfa-verification", "rbac-policy-check", "session-binding", "rate-limiting"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
