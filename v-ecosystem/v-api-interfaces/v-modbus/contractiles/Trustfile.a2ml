#
# Contractile trust specification for the v-modbus protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "network-facing-industrial-control"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "register-address-bounds", "function-code-validation", "unit-id-range", "response-length-validation"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-with-backoff"
rollback = "close-connection"
