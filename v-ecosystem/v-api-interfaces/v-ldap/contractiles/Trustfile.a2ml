#
# Contractile trust specification for the v-ldap protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "network-facing-directory-service"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "ber-encoding-bounds", "dn-syntax-validation", "filter-injection-prevention", "message-id-sequencing"]
build-contract = "v build src/"

[dust]
recovery = "rebind-and-retry"
rollback = "unbind-and-reconnect"
