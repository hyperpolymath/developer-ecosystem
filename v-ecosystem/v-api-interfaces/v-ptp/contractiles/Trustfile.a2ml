#
# Contractile trust specification for the v-ptp protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "time-spoofing-delay-manipulation"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "clock-identity-check", "sequence-id-matching", "domain-number-validation", "timestamp-bounds-check"]
build-contract = "v build src/"

[dust]
recovery = "resync-with-grandmaster"
rollback = "reset-and-reconnect"
