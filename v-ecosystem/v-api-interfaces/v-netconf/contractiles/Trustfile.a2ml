#
# Contractile trust specification for the v-netconf protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "config-injection-privilege-escalation-dos"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "message-id-matching", "capability-negotiation", "xml-sanitisation", "lock-management"]
build-contract = "v build src/"

[dust]
recovery = "close-and-reconnect-session"
rollback = "reset-and-reconnect"
