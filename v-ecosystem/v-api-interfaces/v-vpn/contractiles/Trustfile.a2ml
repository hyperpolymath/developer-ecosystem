#
# Contractile trust specification for the v-vpn protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "privileged-network-tunnel"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "key-material-handling", "command-injection-prevention", "peer-identity-verification", "privilege-boundary"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-tunnel"
rollback = "tear-down-interface"
