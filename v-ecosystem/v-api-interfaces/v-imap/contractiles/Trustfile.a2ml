#
# Contractile trust specification for the v-imap protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "credential-theft-mailbox-enumeration"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "tag-matching", "starttls-enforcement", "uid-validity-check", "literal-size-limit"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-reselect-mailbox"
rollback = "reset-and-reconnect"
