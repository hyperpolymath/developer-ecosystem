#
# Contractile trust specification for the v-smb protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "relay-attack-credential-theft-ransomware-propagation"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "dialect-negotiation-validation", "signing-enforcement", "encryption-enforcement", "path-traversal-check"]
build-contract = "v build src/"

[dust]
recovery = "reconnect-and-reauthenticate"
rollback = "reset-and-reconnect"
