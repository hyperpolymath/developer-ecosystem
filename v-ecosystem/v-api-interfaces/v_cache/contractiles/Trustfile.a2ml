#
# Contractile trust specification for the v-cache protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "cache-poisoning-timing-attacks-data-leakage"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "key-sanitisation", "ttl-enforcement", "cas-token-check", "connection-pool-bounds"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
