#
# Contractile trust specification for the v-ctlog protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "log-tampering-sct-forgery-misissued-certificate-blindness"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "sct-signature-verification", "merkle-proof-validation", "log-consistency-check", "timestamp-freshness"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-backoff"
rollback = "reset-and-reconnect"
