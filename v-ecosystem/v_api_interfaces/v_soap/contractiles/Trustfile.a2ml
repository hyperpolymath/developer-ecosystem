#
# Contractile trust specification for the v-soap protocol module.
# Evaluated by the contractile-cli (must/trust/dust/intend/k9) toolchain.

[trust]
post-quantum-keys = "pending"
threat-model = "network-facing-xml"
formal-verification = "idris2-abi"
audit-status = "unaudited"

[must]
invariant-checks = ["input-validation", "bounds-checking", "utf8-validation", "xml-entity-expansion-limit", "namespace-validation"]
build-contract = "v build src/"

[dust]
recovery = "retry-with-fault-inspect"
rollback = "return-fault-envelope"
