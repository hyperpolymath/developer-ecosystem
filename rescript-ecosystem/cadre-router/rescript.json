{
  "name": "@anthropics/cadre-router",
  "sources": [
    { "dir": "src/tea" },
    { "dir": "src/client" },
    { "dir": "tests", "type": "dev" }
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true
    }
  ],
  "suffix": ".res.mjs",
  "bs-dependencies": [
