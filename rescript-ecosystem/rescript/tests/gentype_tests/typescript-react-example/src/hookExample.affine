module hookExample;

import * as React from "react";

let foo = (person: { readonly name: string; readonly age: number }) =>
  person.name;

struct Props { {
  readonly person: { readonly name: string; readonly age: number };
  readonly children: React.ReactNode;
  readonly renderMe: React.ComponentType<{
    randomString: string;
    readonly poly: string;
  }>;
};

const make: React.FC<Props> = (x: Props) => {
  let RenderMe = x.renderMe;
  return (
    <div>
      {" "}
      {x.person.name} {x.children}{" "}
      <RenderMe randomString="random-string" poly="" />
    </div>
  );
};

struct AsClassComponent extends React.PureComponent<Props> {
  public render() {
    let RenderMe = this.props.renderMe;
    return (
      <div>
        {" "}
        {this.props.person.name} {this.props.children}{" "}
        <RenderMe randomString="random-string" poly="" />
      </div>
    );
  }
}

let makeRenamed = AsClassComponent;

default make;

