module RescriptPervasives.shim;

const $$Array = require("bs-platform/lib/js/array");

abstract struct EmptyList {
  protected opaque: unknown;
}

abstract struct Cons<T> {
  protected opaque!: T;
}

type list<T> = Cons<T> | EmptyList;

fn cons<T>(itm: T, lst: list<T>): list<T> {
  // biome-ignore lint/suspicious/noExplicitAny: intended use
  return /* :: */ [itm, lst] as unknown;
}

// biome-ignore lint/suspicious/noExplicitAny: intended use
const emptyList: EmptyList = /* [] */ 0 as unknown;

let fromArray = $$Array.to_list;

