module types.d;

// SPDX-License-Identifier: MPL-2.0
// Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
//
// affine-ts: Enhanced TypeScript declarations
//
// Re-exports everything from affine-js and adds affine-ts typed helpers.

* from "@hyperpolymath/affine-js";

import type {
  AffineModule,
  AffineValue,
  AffineSome,
  AffineNone,
  AffineOk,
  AffineErr,
  AffineInt,
  AffineFloat,
  AffineBool,
  AffineString,
} from "@hyperpolymath/affine-js";

// ── Typed call helpers ────────────────────────────────────────────────────────

/** Call an and coerce the return value to Int. */
declare fn callInt(mod: AffineModule, name: string, ...args: AffineValue[]): AffineInt;

/** Call an and coerce the return value to Float. */
declare fn callFloat(mod: AffineModule, name: string, ...args: AffineValue[]): AffineFloat;

/** Call an and coerce the return value to Bool. */
declare fn callBool(mod: AffineModule, name: string, ...args: AffineValue[]): AffineBool;

/** Call an and coerce the return value to String. */
declare fn callString(mod: AffineModule, name: string, ...args: AffineValue[]): AffineString;

/** Call an and coerce the return value to Option. */
declare fn callOption(mod: AffineModule, name: string, ...args: AffineValue[]): AffineSome | AffineNone;

/** Call an and coerce the return value to Result. */
declare fn callResult(mod: AffineModule, name: string, ...args: AffineValue[]): AffineOk | AffineErr;

// ── Narrowing helpers ─────────────────────────────────────────────────────────

/** Assert Some and extract payload; throws on None. */
declare fn expectSome(value: AffineValue): AffineValue;

/** Assert Ok and extract payload; throws on Err with message. */
declare fn expectOk(value: AffineValue): AffineValue;

/** Type-narrowing predicate: is this value None? */
declare fn isNone(value: AffineValue): value is AffineNone;

/** Type-narrowing predicate: is this value Some? */
declare fn isSome(value: AffineValue): value is AffineSome;

/** Type-narrowing predicate: is this value Ok? */
declare fn isOk(value: AffineValue): value is AffineOk;

/** Type-narrowing predicate: is this value Err? */
declare fn isErr(value: AffineValue): value is AffineErr;

