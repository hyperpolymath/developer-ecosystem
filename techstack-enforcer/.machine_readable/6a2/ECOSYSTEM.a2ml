# ECOSYSTEM.a2ml — Techstack Enforcer ecosystem position
[metadata]
version = "1.0"
last-updated = "2026-04-11"

[project]
name = "Techstack Enforcer"
purpose = "Formally verified multi-layer technology stack enforcement — blocks forbidden languages/patterns via git hooks, CI/CD, file watchers, and container guards"
role = "policy-enforcement-tool"

[position-in-ecosystem]
category = "rsr-enforcement"

[related-projects]
projects = [
  { name = "rsr-template-repo", relationship = "should-include-by-default" },
  { name = "reposystem", relationship = "validates-policies-for" },
  { name = "gitbot-fleet", relationship = "provides-checks-for" },
  { name = "scaffoldia", relationship = "validates-templates" },
  { name = "gitvisor", relationship = "integrates-with" },
  { name = "rhodibot", relationship = "used-by" },
  { name = "panic-attacker", relationship = "complements" },
]
