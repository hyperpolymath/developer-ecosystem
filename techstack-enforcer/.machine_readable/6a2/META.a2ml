  { id = "ADR-001", title = "Ada/SPARK for core enforcement engine", status = "accepted", date = "2026-04-11" },
  { id = "ADR-002", title = "Multi-layer blocking architecture", status = "accepted", date = "2026-04-11" },
  { id = "ADR-003", title = "Learning mode from security failures", status = "accepted", date = "2026-04-11" },
